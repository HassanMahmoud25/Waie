generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String?
  /// scrypt hash (see src/lib/auth/password.ts). Null for accounts that never
  /// got a server-side password -- those cannot sign in to the server session.
  passwordHash  String?
  /// Gates /admin. Checked against the database on every guarded request
  /// (src/lib/auth/server.ts), never trusted from the session cookie.
  role          UserRole             @default(USER)
  progresses    WatchProgress[]
  saves         SavedEpisode[]
  notes         Note[]
  follows       FollowedSeries[]
  resetTokens   PasswordResetToken[]
  notifications Notification[]
  createdAt     DateTime             @default(now())
}

/// A single-use, time-limited password reset request (Phase: password reset).
/// The raw token is never stored -- only its SHA-256 hash (see
/// src/lib/auth/reset-token.ts); the raw value exists only in the reset
/// email/URL. `usedAt` is set once the token is consumed so it can never be
/// replayed, and every other outstanding token for the same user is deleted
/// the moment one is actually used (see resetPasswordAction).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Topic {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String?
  imageUrl       String?
  color          String?
  seoTitle       String?
  seoDescription String?
  episodes       EpisodeTopic[]
  series         Series[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Series {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String?
  coverImage       String?
  /// Portrait crop of coverImage for narrow viewports; falls back to coverImage when unset
  /// (mirrors src/types/series.ts). Nullable/optional -- purely additive, no existing rows affected.
  coverImageMobile String?
  heroImage        String?
  position         Int           @default(0)
  status           ContentStatus @default(DRAFT)
  featured         Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  topicId          String?
  topic            Topic?        @relation(fields: [topicId], references: [id])
  episodes         Episode[]
  followers        FollowedSeries[]

  /// The YouTube playlist this series was originally discovered/created
  /// from, kept only for traceability. Once set, sync never uses this to
  /// re-derive title/description/episode membership — the CMS owns those
  /// from this point on (see docs/data-ownership.md).
  sourcePlaylistId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Episode {
  id   String @id @default(cuid())
  slug String @unique

  // ---------------------------------------------------------------------
  // YouTube-owned fields. Every sync run (`syncMetadata`, `importFullChannel`)
  // freely overwrites these from the YouTube Data API response — they are
  // never edited by hand in the CMS. `youtubeVideoId` is the stable,
  // idempotency key for every import/sync operation.
  // ---------------------------------------------------------------------
  youtubeVideoId         String   @unique
  youtubeUrl             String
  youtubeChannelId       String
  youtubeTitle           String
  youtubeDescription     String?
  youtubeThumbnailUrl    String
  youtubeDurationSeconds Int
  youtubePublishedAt     DateTime

  // ---------------------------------------------------------------------
  // Editorial/CMS-owned fields. Nullable so the repository layer can fall
  // back to the matching youtube* field when an editor hasn't overridden
  // it yet. Sync NEVER writes to any field in this block once the episode
  // row exists — see lib/sync/upsert-episode.ts.
  // ---------------------------------------------------------------------
  title          String?
  description    String?
  thumbnailUrl   String?
  // Direct URL of an audio file Waie owns for this episode -- enables real
  // background playback (HTML5 audio + Media Session). Never sourced from YouTube.
  audioUrl       String?
  episodeNumber  Int?
  seriesOrder    Int?
  status         ContentStatus @default(PUBLISHED)
  featured       Boolean       @default(false)
  seoTitle       String?
  seoDescription String?

  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id])

  topics          EpisodeTopic[]
  collectionItems CollectionItem[]
  progresses      WatchProgress[]
  saves           SavedEpisode[]
  notes           Note[]
  transcripts     Transcript[]
  recommendations Recommendation[]
  mindMap         MindMap?
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId])
  @@index([status, youtubePublishedAt])
}

model EpisodeTopic {
  episodeId String
  topicId   String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([episodeId, topicId])
}

model Collection {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  description    String?
  coverImage     String?
  kind           String           @default("EDITORIAL")
  status         ContentStatus    @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  items          CollectionItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CollectionItem {
  collectionId String
  episodeId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  episode      Episode    @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([collectionId, episodeId])
}

model WatchProgress {
  userId    String
  episodeId String
  seconds   Int      @default(0)
  duration  Int      @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  /// Powers "History" (recently watched) — derived by ordering on this
  /// index rather than maintaining a separate History table.
  @@index([userId, updatedAt])
}

model SavedEpisode {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
}

/// A user following a Series (Phase 4A) -- same shape/conventions as
/// SavedEpisode above. The composite id doubles as the uniqueness guarantee
/// (a user can't follow the same series twice) and gives userId a free
/// index; `@@index([seriesId])` is the other direction, so the future
/// notification system can answer "which users follow this Series" without
/// a table scan.
model FollowedSeries {
  userId    String
  seriesId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@index([seriesId])
}

/// Phase 4C: the only notification type today is a followed series' episode
/// going live. Kept as an enum (matching this schema's existing convention --
/// ContentStatus, UserRole, ...) rather than a free string, and deliberately
/// narrow -- add a value here only once a second real trigger exists.
enum NotificationType {
  NEW_EPISODE
}

/// A persistent in-app notification for one user (Phase 4C). `episodeId` is
/// nullable so the model isn't NEW_EPISODE-specific, but for that type it's
/// always set -- `@@unique([userId, type, episodeId])` is what actually makes
/// "publish" idempotent: a repeat publish of the same episode hits this
/// constraint (via createMany's skipDuplicates in
/// lib/notifications/notify.ts) instead of relying on application logic
/// alone. `href` is precomputed at creation time (e.g. `/episodes/[slug]`) so
/// the UI never has to re-derive a route from `type` + `episodeId`.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  href      String
  episodeId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, type, episodeId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  seconds   Int
  body      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([episodeId, seconds])
}

model Transcript {
  id        String   @id @default(cuid())
  episodeId String
  language  String   @default("ar")
  /// The complete transcript as a single plain-text body (Phase 5H) -- not a
  /// collection of timestamped segments. Chapter/section structure with
  /// timestamps belongs to MindMap instead.
  text      String
  source    String?
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([episodeId, language])
}

/// YOUTUBE/SOUNDCLOUD/FACEBOOK/INSTAGRAM/EXTERNAL added in Phase 5I to match
/// the type system the public UI (src/types/recommendation.ts, typeMeta in
/// recommendations-panel.tsx) already designed for -- additive only, nothing
/// renamed or removed. MOVIE/PERSON/PRODUCT/STUDY/REFERENCE are pre-redesign
/// legacy values kept so any old row of that type would keep rendering; the
/// Admin editor's "add new" list only offers the current 8, not these 5.
enum RecommendationType {
  YOUTUBE
  SOUNDCLOUD
  PODCAST
  FACEBOOK
  INSTAGRAM
  BOOK
  WEBSITE
  EXTERNAL
  MOVIE
  PERSON
  PRODUCT
  STUDY
  REFERENCE
}

/// Something a host/guest mentioned in an episode — powers the "التوصيات" tab.
model Recommendation {
  id               String             @id @default(cuid())
  episodeId        String
  episode          Episode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type             RecommendationType
  title            String
  description      String?
  /// Why it was mentioned — the editorial value-add over a plain link list.
  reason           String?
  imageUrl         String?
  url              String?
  /// Nullable on purpose — only set from YouTube chapters, transcript
  /// segmentation, or manual editorial curation. Never fabricated.
  timestampSeconds Int?
  order            Int                @default(0)
  createdAt        DateTime           @default(now())
}

/// Manually authored today (see src/types/mind-map.ts); an AI pipeline can
/// populate the same `nodes` shape later without a schema change.
model MindMap {
  id        String   @id @default(cuid())
  episodeId String   @unique
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title     String
  /// Serialized MindMapNode tree: { id, label, description?, timestampSeconds?, children[] }.
  nodes     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A YouTube Short -- structurally separate from Episode by design (Phase
/// 5A/5B). Shorts entered the Episode pipeline for months because the sync
/// system had no content-type classification at all; a shared table made
/// that leak possible everywhere an Episode could be read (search, related,
/// collections, sitemap, ...). This model deliberately has NO relation to
/// Series, Topic, Collection, Note, SavedEpisode or WatchProgress -- a Short
/// is not an Episode variant, and no existing Episode-shaped query can ever
/// see this table, by construction, without a new import written on purpose.
/// `youtubeVideoId` is the idempotency key, exactly like Episode's.
model Short {
  id                     String        @id @default(cuid())
  slug                   String        @unique
  youtubeVideoId         String        @unique
  youtubeTitle           String
  youtubeThumbnailUrl    String
  youtubeDurationSeconds Int
  youtubePublishedAt     DateTime
  status                 ContentStatus @default(DRAFT)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

// ===========================================================================
// YouTube ingestion — see src/lib/youtube (API client) and src/lib/sync
// (orchestration). These models never hold editorial content themselves;
// they exist to make sync idempotent, resumable and auditable.
// ===========================================================================

/// Singleton-ish row per synced channel (in practice: one row for @Waie).
/// Caches the channel/uploads-playlist IDs so every sync run doesn't have
/// to re-resolve the handle, and records when each sync kind last ran.
model YouTubeChannel {
  id                 String    @id @default(cuid())
  handle             String    @unique
  channelId          String    @unique
  uploadsPlaylistId  String
  lastFullImportAt   DateTime?
  lastVideoSyncAt    DateTime?
  lastMetadataSyncAt DateTime?
  lastPlaylistSyncAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// A playlist as discovered on YouTube — the *discovery* record, not the
/// editorial one. A Series may reference the playlist it was created from
/// via `Series.sourcePlaylistId`; this row keeps existing independently so
/// "Sync Playlists" can detect new/renamed/resized playlists over time.
model Playlist {
  id                String   @id @default(cuid())
  youtubePlaylistId String   @unique
  title             String
  description       String?
  itemCount         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum SyncType {
  FULL_IMPORT
  NEW_VIDEOS
  METADATA
  PLAYLISTS
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// One row per admin-triggered (or future scheduled) sync operation — what
/// /admin/sync/youtube reads to show live results and run history.
model SyncRun {
  id                  String        @id @default(cuid())
  type                SyncType
  status              SyncRunStatus @default(RUNNING)
  videosDiscovered    Int           @default(0)
  videosCreated       Int           @default(0)
  videosUpdated       Int           @default(0)
  videosSkipped       Int           @default(0)
  /// Classified SHORT and written to the separate Short table -- never counted in videosCreated/videosUpdated.
  shortsCreated       Int           @default(0)
  shortsUpdated       Int           @default(0)
  /// Classification was inconclusive (see lib/sync/classify-video.ts) -- never became an Episode or a Short.
  videosUnknown       Int           @default(0)
  playlistsDiscovered Int           @default(0)
  seriesCreated       Int           @default(0)
  /// Array of { videoId?: string, playlistId?: string, message: string } —
  /// one failed item never aborts the whole run.
  errors              Json?
  startedAt           DateTime      @default(now())
  finishedAt          DateTime?

  @@index([type, startedAt])
}
