DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/waie?schema=public"
# Required by schema.prisma's `directUrl`. Used by the Prisma CLI (migrate/db push),
# not read by the app at runtime. With a pooled DATABASE_URL (e.g. Supabase's
# pgbouncer connection), point this at the non-pooled/direct connection instead.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/waie?schema=public"
NEXT_PUBLIC_SITE_URL="https://site-waie.vercel.app/"

# Server-only. Signs the admin session cookie -- required for /admin login. At least 32
# random characters, e.g. `openssl rand -base64 48`. Rotating it signs every admin out.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Server-only. Never exposed to the browser -- read only in lib/youtube/client.ts.
YOUTUBE_API_KEY=""
# Optional -- defaults to @Waie if unset.
YOUTUBE_CHANNEL_HANDLE="@Waie"

# Optional -- Waie's podcast RSS feed, the source of each episode's audio (Listen mode).
# Defaults to the official feed; set to an empty string to disable Listen mode.
PODCAST_FEED_URL="https://feeds.soundcloud.com/users/soundcloud:users:1073536591/sounds.rss"
